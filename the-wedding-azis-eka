<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
<title>The Wedding of Azis &amp; Eka</title>
<style>
/* ===========================================================
   The Wedding of Azis & Eka — elegant minimalist invitation
   Palette: f3f2ed eae4d8 999386 8a806f 947f6e
   =========================================================== */

@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Jost:wght@300;400;500&display=swap');

:root {
  --cream: #f3f2ed;
  --sand:  #eae4d8;
  --stone: #999386;
  --taupe: #8a806f;
  --mocha: #947f6e;
  --ink:   #3c352b;          /* deep warm brown for text */
  --ink-soft: #5a5142;
  --line:  rgba(60, 53, 43, 0.14);

  --serif: 'Cormorant Garamond', Georgia, serif;
  --sans:  'Jost', system-ui, sans-serif;

  --ease: cubic-bezier(0.76, 0, 0.24, 1);
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  background: var(--cream);
  color: var(--ink);
  font-family: var(--sans);
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

body { overflow: hidden; }

/* ----------------------------------------------------------- */
/* Page stack + slide-up transition                            */
/* ----------------------------------------------------------- */
#stage { position: fixed; inset: 0; overflow: hidden; }

.page {
  position: absolute;
  inset: 0;
  overflow-y: auto;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.95s var(--ease);
  will-change: transform;
  -webkit-overflow-scrolling: touch;
}
.page.is-active { transform: translateY(0); }
.page.is-passed { transform: translateY(-100%); }

.bg-cream { background: var(--cream); }
.bg-sand  { background: var(--sand); }

/* inner column */
.wrap {
  margin: auto;            /* centers short content, clamps to 0 when overflowing */
  width: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding: clamp(48px, 8vh, 110px) clamp(22px, 6vw, 80px);
  gap: clamp(32px, 5vh, 64px);
}

/* ----------------------------------------------------------- */
/* Typography                                                  */
/* ----------------------------------------------------------- */
.eyebrow {
  font-family: var(--sans);
  font-weight: 400;
  font-size: clamp(11px, 1.1vw, 13px);
  letter-spacing: 0.42em;
  text-transform: uppercase;
  color: var(--stone);
  margin: 0;
  padding-left: 0.42em;
  white-space: nowrap;
}

h1, h2, h3 { font-family: var(--serif); font-weight: 400; margin: 0; line-height: 1.04; color: var(--ink); }
h1 { font-size: clamp(44px, 9vw, 132px); font-weight: 300; }
h2 { font-size: clamp(34px, 5.6vw, 76px); font-weight: 300; }
h3 { font-size: clamp(24px, 3vw, 38px); }

.amp { font-style: italic; font-weight: 300; color: var(--mocha); }

p { line-height: 1.85; color: var(--ink-soft); font-weight: 300; margin: 0; }
.lead {
  font-family: var(--serif);
  font-size: clamp(20px, 2.4vw, 30px);
  font-weight: 300;
  font-style: italic;
  line-height: 1.6;
  color: var(--taupe);
}
.body-sm { font-size: clamp(14px, 1.3vw, 16px); letter-spacing: 0.01em; }

.divider {
  width: 1px; height: clamp(40px, 7vh, 78px);
  background: linear-gradient(var(--line), transparent);
}
.rule {
  display: flex; align-items: center; gap: 16px;
  color: var(--stone);
}
.rule::before, .rule::after {
  content: ''; height: 1px; width: clamp(30px, 8vw, 80px);
  background: var(--line);
}
.rule .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--mocha); }

.center { text-align: center; }
.measure { max-width: 56ch; }
.measure-sm { max-width: 42ch; }

/* ----------------------------------------------------------- */
/* Buttons                                                     */
/* ----------------------------------------------------------- */
.btn {
  font-family: var(--sans);
  font-weight: 400;
  font-size: 12px;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: var(--ink);
  background: transparent;
  border: 1px solid var(--taupe);
  padding: 17px 38px 16px;
  cursor: pointer;
  border-radius: 2px;
  transition: background 0.5s var(--ease), color 0.5s var(--ease), border-color 0.5s var(--ease);
  display: inline-flex; align-items: center; gap: 14px;
  text-decoration: none;
}
.btn:hover { background: var(--taupe); color: var(--cream); border-color: var(--taupe); }
.btn .chev { font-size: 14px; transform: translateY(-1px); }
.btn--light { border-color: rgba(255,255,255,0.7); color: #fff; }
.btn--light:hover { background: rgba(255,255,255,0.92); color: var(--ink); border-color: #fff; }
.btn--solid { background: var(--taupe); color: var(--cream); border-color: var(--taupe); }
.btn--solid:hover { background: var(--ink); border-color: var(--ink); }

.continue { margin-top: 8px; }

/* ----------------------------------------------------------- */
/* Image slots                                                 */
/* ----------------------------------------------------------- */
image-slot {
  --slot-bg: #e4ddd0;
  display: block;
  background: var(--slot-bg);
  box-shadow: 0 24px 60px -34px rgba(60,53,43,0.5);
}
.frame { padding: 0; }
image-slot.arch { border-radius: 50% 50% 6px 6px / 32% 32% 4px 4px; overflow: hidden; }

/* ----------------------------------------------------------- */
/* Right-side progress dots                                    */
/* ----------------------------------------------------------- */
#nav {
  position: fixed; right: clamp(16px, 2.4vw, 34px); top: 50%;
  transform: translateY(-50%);
  display: flex; flex-direction: column; gap: 16px;
  z-index: 60; opacity: 0; pointer-events: none;
  transition: opacity 0.6s var(--ease);
}
#nav.show { opacity: 1; }
.nav-dot {
  width: 9px; height: 9px; border-radius: 50%;
  border: 1px solid var(--taupe); background: transparent;
  padding: 0; cursor: pointer; transition: all 0.4s var(--ease);
  position: relative;
}
.nav-dot[disabled] { opacity: 0.32; cursor: default; }
.nav-dot.active { background: var(--taupe); transform: scale(1.18); }

/* back chevron */
#back {
  position: fixed; left: clamp(16px, 2.4vw, 34px); top: clamp(18px, 3vh, 30px);
  z-index: 60; background: none; border: none; cursor: pointer;
  font-family: var(--sans); font-size: 11px; letter-spacing: 0.28em;
  text-transform: uppercase; color: var(--taupe);
  display: inline-flex; align-items: center; gap: 9px;
  opacity: 0; pointer-events: none; transition: opacity 0.5s var(--ease);
}
#back.show { opacity: 1; pointer-events: auto; }
#back:hover { color: var(--ink); }

/* ----------------------------------------------------------- */
/* LOGIN (page 0)                                              */
/* ----------------------------------------------------------- */
#login .wrap { padding: 0; gap: 0; margin: 0; flex: 1 1 auto; }
.login-hero {
  position: relative; width: 100%; flex: 1 1 auto; min-height: 100%;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
}
.login-hero image-slot {
  position: absolute; inset: 0; width: 100%; height: 100%;
  box-shadow: none; --slot-bg: #b8ad9b;
}
.login-overlay {
  position: absolute; inset: 0;
  background:
    linear-gradient(180deg, rgba(60,53,43,0.46) 0%, rgba(60,53,43,0.18) 38%, rgba(60,53,43,0.52) 100%),
    linear-gradient(110deg, rgba(148,127,110,0.42), rgba(153,147,134,0.30));
  z-index: 1;
}
.login-card {
  position: relative; z-index: 2;
  text-align: center; color: #fff;
  padding: 40px clamp(22px, 6vw, 40px);
  display: flex; flex-direction: column; align-items: center;
  gap: clamp(20px, 3.4vh, 34px);
  max-width: 560px; width: 100%;
}
.login-card .eyebrow { color: rgba(255,255,255,0.82); }
.login-card h1 {
  color: #fff; font-style: italic; white-space: nowrap;
  font-size: clamp(46px, 12vw, 92px); line-height: 1;
  text-shadow: 0 2px 30px rgba(0,0,0,0.25);
}
.login-card h1 .amp { color: #efe6db; font-style: normal; }
.login-card .rule { color: rgba(255,255,255,0.7); }
.login-card .rule::before, .login-card .rule::after { background: rgba(255,255,255,0.4); }
.login-card .rule .dot { background: #fff; }
.login-card p { color: rgba(255,255,255,0.88); }

.login-form { display: flex; flex-direction: column; align-items: center; gap: 20px; width: 100%; }
.name-input {
  font-family: var(--serif); font-size: clamp(22px, 3vw, 30px);
  font-weight: 300; text-align: center; color: #fff;
  background: transparent; border: none;
  border-bottom: 1px solid rgba(255,255,255,0.55);
  padding: 10px 8px; width: min(360px, 80vw);
  letter-spacing: 0.02em; outline: none;
  transition: border-color 0.4s var(--ease);
}
.name-input::placeholder { color: rgba(255,255,255,0.5); font-style: italic; }
.name-input:focus { border-color: #fff; }
.login-msg {
  font-family: var(--sans); font-size: 12px; letter-spacing: 0.2em;
  text-transform: uppercase; color: #ffe4d8; min-height: 16px;
  opacity: 0; transition: opacity 0.3s; font-weight: 300;
}
.login-msg.show { opacity: 1; }

/* ----------------------------------------------------------- */
/* Couple names header block                                   */
/* ----------------------------------------------------------- */
.names {
  display: flex; flex-direction: column; align-items: center; gap: 6px;
}
.names .pair {
  display: flex; align-items: center; gap: clamp(18px, 4vw, 48px);
  flex-wrap: wrap; justify-content: center;
}
.names .pair h2 { font-style: italic; }

/* ----------------------------------------------------------- */
/* Location cards (page 2)                                     */
/* ----------------------------------------------------------- */
.loc-grid {
  display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: clamp(24px, 4vw, 52px); width: 100%; max-width: 980px;
}
.loc-card {
  display: flex; flex-direction: column; gap: 22px;
  text-align: center; align-items: center;
}
.loc-card image-slot { width: 100%; }
.loc-meta { display: flex; flex-direction: column; gap: 10px; align-items: center; }
.loc-card .when { font-family: var(--serif); font-size: clamp(18px,2vw,23px); color: var(--mocha); font-style: italic; }

/* ----------------------------------------------------------- */
/* Rundown (page 3)                                            */
/* ----------------------------------------------------------- */
.rundown { width: 100%; max-width: 720px; display: flex; flex-direction: column; }
.live-banner {
  text-align: center; font-size: 12px; letter-spacing: 0.26em; text-transform: uppercase;
  color: var(--stone); margin-bottom: 8px;
}
.live-banner b { color: var(--mocha); font-weight: 500; }
.session {
  display: grid; grid-template-columns: 132px 1fr auto;
  align-items: center; gap: 20px;
  padding: 26px 24px; border-top: 1px solid var(--line);
  transition: background 0.5s var(--ease), padding 0.5s var(--ease);
}
.session:last-child { border-bottom: 1px solid var(--line); }
.session-note {
  padding: 14px 24px; text-align: center; border-top: 1px solid var(--line);
}
.session-note span {
  font-family: var(--serif); font-style: italic;
  font-size: clamp(14px, 1.5vw, 18px); color: var(--mocha); letter-spacing: 0.01em;
}
.session .time { font-family: var(--serif); font-size: clamp(22px,2.4vw,30px); color: var(--ink); font-weight: 400; }
.session .what { text-align: left; }
.session .what .t { display: block; font-family: var(--serif); font-size: clamp(19px,2vw,24px); color: var(--ink); line-height: 1.2; }
.session .what .d { display: block; font-size: 13px; letter-spacing: 0.04em; color: var(--stone); margin-top: 5px; }

/* live countdown */
.countdown {
  display: flex; align-items: flex-start; justify-content: center;
  gap: clamp(8px, 1.6vw, 20px); margin-top: 2px;
}
.cd-unit { display: flex; flex-direction: column; align-items: center; min-width: clamp(54px, 9vw, 84px); }
.cd-num {
  font-family: var(--serif); font-weight: 300; line-height: 1;
  font-size: clamp(40px, 6.4vw, 74px); color: var(--ink);
  font-variant-numeric: tabular-nums; font-feature-settings: "tnum";
}
.cd-lbl {
  font-family: var(--sans); font-size: 10.5px; letter-spacing: 0.26em;
  text-transform: uppercase; color: var(--stone); margin-top: 9px;
}
.cd-sep {
  font-family: var(--serif); font-weight: 300; line-height: 1;
  font-size: clamp(32px, 5vw, 58px); color: var(--mocha); opacity: 0.45;
}
.countdown.ended .cd-num { color: var(--mocha); }
.session .status {
  font-size: 10.5px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--stone);
  white-space: nowrap;
}
.session.active {
  background: rgba(148,127,110,0.13);
  border-radius: 4px; border-color: transparent;
}
.session.active + .session { border-top-color: transparent; }
.session.active .status { color: var(--mocha); display: inline-flex; align-items: center; gap: 7px; }
.session.active .status .pulse {
  width: 7px; height: 7px; border-radius: 50%; background: var(--mocha);
  animation: pulse 1.6s ease-in-out infinite;
}
.session.done { opacity: 0.5; }
@keyframes pulse { 0%,100%{ box-shadow: 0 0 0 0 rgba(148,127,110,0.5);} 50%{ box-shadow: 0 0 0 7px rgba(148,127,110,0);} }

/* ----------------------------------------------------------- */
/* Love story (page 4)                                         */
/* ----------------------------------------------------------- */
.story { width: 100%; max-width: 1040px; display: flex; flex-direction: column; gap: clamp(56px, 9vh, 110px); }
.story-row {
  display: grid; grid-template-columns: 1fr 1fr; gap: clamp(30px, 5vw, 70px);
  align-items: center;
}
.story-row.flip .story-text { order: 2; }
.story-text { display: flex; flex-direction: column; gap: 16px; }
.story-text .yr { font-family: var(--serif); font-style: italic; font-size: clamp(30px,4vw,52px); color: var(--mocha); }
.story image-slot { width: 100%; }

/* parents block */
.parents {
  display: grid; grid-template-columns: 1fr auto 1fr; gap: clamp(20px,4vw,60px);
  align-items: center; width: 100%; max-width: 840px; text-align: center;
}
.parents .who h3 { margin-bottom: 8px; }
.parents .who p { font-size: 14px; line-height: 1.7; }
.parents .amp-big { font-family: var(--serif); font-style: italic; font-size: clamp(40px,7vw,84px); color: var(--mocha); font-weight: 300; }

/* ----------------------------------------------------------- */
/* Gallery (page 5)                                            */
/* ----------------------------------------------------------- */
.gallery-head { text-align: center; max-width: 640px; }
.gallery-head .eyebrow { margin: 0; }
.gallery-head h2 { margin: 14px 0 0; }
.gallery-head .sub { margin: 14px 0 0; }

/* horizontal draggable bento row */
.bento-scroll {
  align-self: stretch;
  margin-inline: calc(-1 * clamp(22px, 6vw, 80px));
  padding: 6px clamp(22px, 6vw, 80px) 16px;
  overflow-x: auto; overflow-y: hidden;
  cursor: grab; -webkit-overflow-scrolling: touch;
  scrollbar-width: none; scroll-snap-type: x proximity;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
          mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
}
.bento-scroll::-webkit-scrollbar { display: none; }
.bento-scroll.dragging { cursor: grabbing; scroll-snap-type: none; }

.bento-grid {
  display: grid; grid-auto-flow: column;
  grid-template-rows: repeat(2, 1fr);
  grid-auto-columns: clamp(214px, 25vw, 290px);
  gap: clamp(12px, 1.4vw, 18px);
  height: clamp(440px, 64vh, 568px);
  width: max-content;
}
.bento-card {
  position: relative; overflow: hidden;
  border-radius: 14px; border: 1px solid var(--line);
  background: #e4ddd0; cursor: pointer;
  scroll-snap-align: start;
  box-shadow: 0 18px 44px -32px rgba(60,53,43,0.55);
  opacity: 0; transform: translateY(22px) scale(0.96);
}
.bento-card:hover { box-shadow: 0 26px 60px -26px rgba(60,53,43,0.62); }
.bento-grid.revealed .bento-card {
  opacity: 1; transform: none;
  transition: opacity .6s var(--ease), transform .6s var(--ease), box-shadow .4s var(--ease);
}
.bento-grid.revealed .bento-card:nth-child(1) { transition-delay: .00s; }
.bento-grid.revealed .bento-card:nth-child(2) { transition-delay: .08s; }
.bento-grid.revealed .bento-card:nth-child(3) { transition-delay: .16s; }
.bento-grid.revealed .bento-card:nth-child(4) { transition-delay: .24s; }
.bento-grid.revealed .bento-card:nth-child(5) { transition-delay: .32s; }
.bento-grid.revealed .bento-card:nth-child(6) { transition-delay: .40s; }

.bento-card > image-slot {
  position: absolute; inset: 0; width: 100%; height: 100%;
  box-shadow: none; transition: transform .6s var(--ease);
}
.bento-card:hover > image-slot { transform: scale(1.06); }
.bento-grad {
  position: absolute; inset: 0; z-index: 2; pointer-events: none;
  background: linear-gradient(to top, rgba(40,34,26,.82), rgba(40,34,26,.30) 46%, transparent 74%);
  opacity: 0; transition: opacity .5s var(--ease);
}
.bento-card:hover .bento-grad { opacity: 1; }
.bento-no {
  position: absolute; top: 14px; left: 17px; z-index: 3; pointer-events: none;
  font-family: var(--serif); font-style: italic; font-size: 18px;
  color: #fff; opacity: 0; transition: opacity .5s var(--ease);
  text-shadow: 0 1px 10px rgba(0,0,0,.45);
}
.bento-card:hover .bento-no { opacity: .9; }
.bento-cap {
  position: absolute; left: 0; bottom: 0; z-index: 3; pointer-events: none;
  padding: 0 22px 22px;
  transform: translateY(14px); opacity: 0;
  transition: transform .5s var(--ease), opacity .5s var(--ease);
}
.bento-card:hover .bento-cap { transform: none; opacity: 1; }
.bento-cap h3 { color: #fff; font-size: clamp(20px, 2vw, 26px); }
.bento-cap p { color: rgba(255,255,255,.82); font-size: 13px; letter-spacing: .03em; margin-top: 4px; }

.b-2x2 { grid-row: span 2; grid-column: span 2; }
.b-2   { grid-row: span 2; }

/* lightbox */
#lightbox {
  position: fixed; inset: 0; z-index: 200; display: none;
  align-items: center; justify-content: center; padding: 5vmin;
  background: rgba(30,26,20,.84); -webkit-backdrop-filter: blur(7px); backdrop-filter: blur(7px);
}
#lightbox.open { display: flex; animation: lbfade .3s var(--ease); }
#lightbox .lb-inner { position: relative; max-width: min(1000px, 92vw); animation: lbpop .45s var(--ease); }
#lightbox img { max-height: 84vh; max-width: 100%; border-radius: 10px; display: block; box-shadow: 0 30px 80px -20px rgba(0,0,0,.6); }
#lb-cap { margin-top: 18px; text-align: center; }
#lb-cap h3 { font-family: var(--serif); font-style: italic; font-size: clamp(22px,3vw,30px); color: #fff; }
#lb-cap p { color: rgba(255,255,255,.7); font-size: 13px; letter-spacing: .04em; margin-top: 4px; }
#lb-close {
  position: fixed; top: clamp(16px,3vh,30px); right: clamp(16px,3vw,30px); z-index: 201;
  background: none; border: none; cursor: pointer; color: rgba(255,255,255,.8);
  transition: color .3s var(--ease), transform .3s var(--ease);
}
#lb-close:hover { color: #fff; transform: rotate(90deg); }
@keyframes lbfade { from { opacity: 0; } to { opacity: 1; } }
@keyframes lbpop  { from { opacity: 0; transform: scale(.94); } to { opacity: 1; transform: none; } }

/* ----------------------------------------------------------- */
/* Thank you (page 6)                                          */
/* ----------------------------------------------------------- */
.thanks-photos {
  display: flex; gap: clamp(14px,2vw,26px); align-items: flex-end; justify-content: center;
  flex-wrap: wrap;
}
.thanks-photos image-slot:nth-child(odd) { transform: translateY(14px); }

/* ----------------------------------------------------------- */
/* Responsive                                                  */
/* ----------------------------------------------------------- */
@media (max-width: 760px) {
  .loc-grid { grid-template-columns: 1fr; }
  .story-row { grid-template-columns: 1fr; gap: 26px; }
  .story-row.flip .story-text { order: 0; }
  .bento-grid { height: clamp(380px,68vh,460px); grid-auto-columns: clamp(180px,72vw,236px); }
  .bento-card .bento-grad { opacity: 1; }
  .bento-card .bento-cap { opacity: 1; transform: none; }
  .bento-card .bento-no { opacity: .9; }
  .session { grid-template-columns: 92px 1fr; }
  .session .status { grid-column: 2; justify-self: start; }
  .parents { grid-template-columns: 1fr; gap: 18px; }
  .parents .amp-big { font-size: 44px; }
  #nav { right: 12px; }
}

@media (prefers-reduced-motion: reduce) {
  .page { transition: none; }
  .session.active .status .pulse { animation: none; }
}

</style>
</head>
<body>

<div id="stage">

  <!-- ===================================================== -->
  <!-- PAGE 0 — LOGIN                                         -->
  <!-- ===================================================== -->
  <section class="page is-active" id="login" data-screen-label="Login">
    <div class="wrap">
      <div class="login-hero">
        <image-slot id="login-photo" fit="cover" shape="rect"
          placeholder="Foto mempelai — layar penuh"></image-slot>
        <div class="login-overlay"></div>

        <div class="login-card">
          <p class="eyebrow">The Wedding Of</p>
          <h1>Azis <span class="amp">&amp;</span> Eka</h1>
          <div class="rule"><span class="dot"></span></div>
          <p class="measure-sm body-sm">Sebuah undangan untuk merayakan hari bahagia kami.
            Silakan masukkan nama Anda untuk membuka undangan.</p>

          <form class="login-form" id="login-form" autocomplete="off">
            <input class="name-input" id="name-input" type="text"
              placeholder="Tuliskan nama Anda…" aria-label="Nama tamu" />
            <div class="login-msg" id="login-msg"></div>
            <button class="btn btn--light" type="submit">Buka Undangan <span class="chev">↑</span></button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- PAGE 1 — QUOTE · COUPLE · LOCATIONS                    -->
  <!-- ===================================================== -->
