<script>
/* App controller: page stack, slide-up navigation, login gating,
   and the live event rundown for August 2, 2026. */

(function () {
  const stage = document.getElementById('stage');
  const pages = Array.from(document.querySelectorAll('.page'));
  const nav   = document.getElementById('nav');
  const back  = document.getElementById('back');

  const LS_PAGE = 'azeka.page';
  const LS_GUEST = 'azeka.guest';
  const LS_UNLOCK = 'azeka.unlocked';

  let current = 0;
  let unlocked = parseInt(localStorage.getItem(LS_UNLOCK) || '0', 10); // furthest reachable index

  /* ---------- build right-side nav dots ---------- */
  pages.forEach((_, i) => {
    const b = document.createElement('button');
    b.className = 'nav-dot';
    b.setAttribute('aria-label', 'Halaman ' + (i + 1));
    b.addEventListener('click', () => { if (i <= unlocked) goTo(i); });
    nav.appendChild(b);
  });
  const dots = Array.from(nav.children);

  function render() {
    pages.forEach((p, i) => {
      p.classList.toggle('is-active', i === current);
      p.classList.toggle('is-passed', i < current);
      p.style.zIndex = String(i + 1); // higher index always composites on top
      p.setAttribute('aria-hidden', i === current ? 'false' : 'true');
    });
    dots.forEach((d, i) => {
      d.classList.toggle('active', i === current);
      d.disabled = i > unlocked;
    });
    // chrome only after login (page 0 is login)
    const showChrome = current >= 1;
    nav.classList.toggle('show', showChrome);
    back.classList.toggle('show', current >= 1);
    localStorage.setItem(LS_PAGE, String(current));
    localStorage.setItem(LS_UNLOCK, String(unlocked));
  }

  function goTo(i) {
    if (i < 0 || i >= pages.length) return;
    current = i;
    if (i > unlocked) unlocked = i;
    // reset scroll of the page we land on
    const p = pages[i];
    if (p) p.scrollTop = 0;
    render();
    if (i === 2) Rundown.refresh(); // refresh live status when entering rundown
  }
  function next() { goTo(current + 1); }
  function prev() { goTo(Math.max(0, current - 1)); }

  window.WeddingNav = { goTo, next, prev };

  /* ---------- continue buttons ---------- */
  document.querySelectorAll('[data-continue]').forEach(btn => {
    btn.addEventListener('click', next);
  });
  back.addEventListener('click', prev);

  /* keyboard: only as a convenience once unlocked */
  document.addEventListener('keydown', (e) => {
    if (current === 0) return;
    if (e.key === 'ArrowDown' || e.key === 'PageDown') { if (current < unlocked) { next(); e.preventDefault(); } }
    if (e.key === 'ArrowUp'   || e.key === 'PageUp')   { prev(); e.preventDefault(); }
  });

  /* ---------- login ---------- */
  const form  = document.getElementById('login-form');
  const input = document.getElementById('name-input');
  const msg   = document.getElementById('login-msg');

  function admit(name) {
    const nice = GuestBook.display(name);
    localStorage.setItem(LS_GUEST, nice);
    document.querySelectorAll('[data-guest]').forEach(el => { el.textContent = nice; });
    unlocked = Math.max(unlocked, 1);
    goTo(1);
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const val = input.value.trim();
    if (!val) return;
    if (GuestBook.has(val)) {
      msg.classList.remove('show');
      admit(val);
    } else {
      msg.textContent = 'Maaf, nama tidak ditemukan dalam daftar tamu';
      msg.classList.add('show');
      input.focus();
      input.select();
    }
  });

  /* ---------- restore session ---------- */
  GuestBook.load().then(() => {
    const guest = localStorage.getItem(LS_GUEST);
    if (guest) {
      document.querySelectorAll('[data-guest]').forEach(el => { el.textContent = guest; });
      const saved = parseInt(localStorage.getItem(LS_PAGE) || '1', 10);
      unlocked = Math.max(unlocked, 1);
      current = isNaN(saved) ? 1 : Math.min(Math.max(saved, 1), pages.length - 1);
    } else {
      current = 0;
    }
    render();
    Rundown.start();
  });

  /* =========================================================
     Live event rundown — August 2, 2026 (WIB / UTC+7)
     ========================================================= */
  const Rundown = (function () {
    // session windows in WIB on the wedding day
    const sessions = [
      { start: '09:00', end: '11:00', t: 'Akad Nikah' },
      { start: '11:00', end: '11:10', t: 'Walimatul Ursy' },
      { start: '11:10', end: '11:20', t: 'Sambutan dari Wakil Keluarga' },
      { start: '11:20', end: '11:30', t: 'Sambutan Pengantin' },
      { start: '11:30', end: '11:40', t: 'Pembacaan Doa' },
      { start: '11:40', end: '12:00', t: 'Penutup Acara dari MC' },
    ];
    const WIB_OFFSET = 7 * 60; // minutes
    // build absolute UTC ms for each window on 2026-08-02 WIB
    function wibToUTC(hhmm) {
      const [h, m] = hhmm.split(':').map(Number);
      // 2026-08-02 h:m WIB  ->  subtract 7h to get UTC
      return Date.UTC(2026, 7, 2, h, m) - WIB_OFFSET * 60 * 1000;
    }
    sessions.forEach(s => { s.s = wibToUTC(s.start); s.e = wibToUTC(s.end); });
    const eventStart = sessions[0].s;
    const eventEnd = sessions[sessions.length - 1].e;

    let nodes = [];
    let banner = null;
    let timer = null;
    let cd = null;

    function pad(n) { return String(n).padStart(2, '0'); }

    function fmtCountdown(ms) {
      const d = Math.floor(ms / 86400000);
      const h = Math.floor((ms % 86400000) / 3600000);
      const mn = Math.floor((ms % 3600000) / 60000);
      if (d > 0) return `${d} hari ${h} jam lagi`;
      if (h > 0) return `${h} jam ${mn} menit lagi`;
      const sec = Math.floor((ms % 60000) / 1000);
      return `${mn} menit ${sec} detik lagi`;
    }

    function refresh() {
      const now = Date.now();
      let activeIdx = -1;
      sessions.forEach((s, i) => { if (now >= s.s && now < s.e) activeIdx = i; });

      nodes.forEach((node, i) => {
        const s = sessions[i];
        node.el.classList.toggle('active', i === activeIdx);
        node.el.classList.toggle('done', now >= s.e);
        let label = '';
        if (i === activeIdx) label = '<span class="pulse"></span> Sedang Berlangsung';
        else if (now >= s.e) label = 'Selesai';
        else label = 'Akan Datang';
        node.status.innerHTML = label;
      });

      // live countdown (updates every second)
      if (cd && cd.wrap) {
        if (now < eventStart) {
          const diff = eventStart - now;
          cd.d.textContent = pad(Math.floor(diff / 86400000));
          cd.h.textContent = pad(Math.floor((diff % 86400000) / 3600000));
          cd.m.textContent = pad(Math.floor((diff % 3600000) / 60000));
          cd.s.textContent = pad(Math.floor((diff % 60000) / 1000));
          cd.wrap.classList.remove('ended');
          if (cd.cap) cd.cap.textContent = 'Menuju Hari Bahagia';
        } else {
          cd.d.textContent = '00'; cd.h.textContent = '00';
          cd.m.textContent = '00'; cd.s.textContent = '00';
          cd.wrap.classList.add('ended');
          if (cd.cap) cd.cap.textContent = (now >= eventEnd) ? 'Hari Bahagia Telah Usai' : 'Hari Bahagia Telah Tiba';
        }
      }

      if (!banner) return;
      if (now < eventStart) {
        banner.innerHTML = 'Dengan penuh suka cita, kami menanti kehadiran Anda';
      } else if (now >= eventEnd) {
        banner.innerHTML = '<b>Terima kasih</b> telah menjadi bagian dari hari bahagia kami';
      } else if (activeIdx >= 0) {
        banner.innerHTML = 'Sedang berlangsung — <b>' + sessions[activeIdx].t + '</b>';
      } else {
        banner.innerHTML = 'Acara sedang berlangsung';
      }
    }

    function start() {
      banner = document.getElementById('live-banner');
      cd = {
        wrap: document.getElementById('countdown'),
        cap:  document.getElementById('cd-caption'),
        d: document.getElementById('cd-d'), h: document.getElementById('cd-h'),
        m: document.getElementById('cd-m'), s: document.getElementById('cd-s'),
      };
      nodes = Array.from(document.querySelectorAll('.session')).map(el => ({
        el, status: el.querySelector('.status')
      }));
      refresh();
      clearInterval(timer);
      timer = setInterval(refresh, 1000);
    }

    return { start, refresh };
  })();
})();

</script>
<script>
/* Bento gallery: drag-to-scroll, staggered reveal, and lightbox.
   Reads the user's dropped photo from each <image-slot>'s open shadow root
   so the lightbox can enlarge it. Empty cards fall through to the slot's own
   click-to-upload. */

(function () {
  const scroll  = document.getElementById('bento-scroll');
  const grid    = document.getElementById('bento-grid');
  const gallery = document.getElementById('gallery');
  const lb       = document.getElementById('lightbox');
  const lbImg    = document.getElementById('lb-img');
  const lbCap    = document.getElementById('lb-cap');
  const lbClose  = document.getElementById('lb-close');
  if (!scroll || !grid) return;

  /* ---- staggered reveal once the gallery becomes the active page ---- */
  let revealed = false;
  function maybeReveal() {
    if (!revealed && gallery.classList.contains('is-active')) {
      grid.classList.add('revealed');
      revealed = true;
    }
  }
  new MutationObserver(maybeReveal).observe(gallery, { attributes: true, attributeFilter: ['class'] });
  maybeReveal();

  /* ---- drag-to-scroll (pointer) ---- */
  let down = false, startX = 0, startLeft = 0, moved = 0;
  scroll.addEventListener('pointerdown', (e) => {
    down = true; moved = 0; startX = e.clientX; startLeft = scroll.scrollLeft;
    scroll.classList.add('dragging');
  });
  window.addEventListener('pointermove', (e) => {
    if (!down) return;
    const dx = e.clientX - startX;
    moved = Math.max(moved, Math.abs(dx));
    scroll.scrollLeft = startLeft - dx;
  });
  window.addEventListener('pointerup', () => { down = false; scroll.classList.remove('dragging'); });
  /* vertical wheel → horizontal pan */
  scroll.addEventListener('wheel', (e) => {
    if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) { scroll.scrollLeft += e.deltaY; e.preventDefault(); }
  }, { passive: false });

  /* ---- card click → lightbox (filled) ; empty falls through to slot upload ---- */
  function slotSrc(slot) {
    if (!slot.hasAttribute('data-filled')) return null;
    const img = slot.shadowRoot && slot.shadowRoot.querySelector('img');
    const s = img && img.getAttribute('src');
    return s || null;
  }
  grid.querySelectorAll('.bento-card').forEach((card) => {
    card.addEventListener('click', () => {
      if (moved > 6) return;                 // it was a drag, not a tap
      const slot = card.querySelector('image-slot');
      const src = slotSrc(slot);
      if (src) openLB(src, card.dataset.title, card.dataset.desc);
      // empty: do nothing here — the image-slot handles its own click-to-upload
    });
  });

  function openLB(src, title, desc) {
    lbImg.src = src;
    lbCap.innerHTML = (title ? '<h3>' + title + '</h3>' : '') + (desc ? '<p>' + desc + '</p>' : '');
    lb.classList.add('open');
    lb.setAttribute('aria-hidden', 'false');
  }
  function closeLB() {
    lb.classList.remove('open');
    lb.setAttribute('aria-hidden', 'true');
    setTimeout(() => { if (!lb.classList.contains('open')) lbImg.removeAttribute('src'); }, 300);
  }
  lbClose.addEventListener('click', closeLB);
  lb.addEventListener('click', (e) => { if (e.target === lb) closeLB(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lb.classList.contains('open')) closeLB(); });
})();

</script>
<script>
/* ---- Background music: autoplay + loop ---- */
(function () {
  const audio = new Audio('Lagu_Azis.mp3');
  audio.loop = true;
  audio.volume = 0.5;

  function tryPlay() {
    audio.play().catch(() => {
      // Autoplay blocked — retry on first user interaction
      const resume = () => { audio.play(); document.removeEventListener('click', resume); document.removeEventListener('touchstart', resume); };
      document.addEventListener('click', resume, { once: true });
      document.addEventListener('touchstart', resume, { once: true });
    });
  }

  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    tryPlay();
  } else {
    document.addEventListener('DOMContentLoaded', tryPlay);
  }
})();
</script>
